# Environment variables for local development and deployment.
# Copy this to a new file named `.env.local` (or set env vars in your deployment platform).

# MongoDB connection string (server-only; do NOT expose publicly)
# Example (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=

# imgbb API key (safe to expose to client). Used for image uploads.
NEXT_PUBLIC_IMGBB_API_KEY=
